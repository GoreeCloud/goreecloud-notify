# Source-controlled production configuration template.
# This file contains no reusable secret and is intentionally incomplete until the
# target environment supplies its approved reverse-proxy network CIDR.
GOREECLOUD_NOTIFY_ENVIRONMENT=production
GOREECLOUD_NOTIFY_DATABASE_URL=sqlite:////data/goreecloud_notify.db
GOREECLOUD_NOTIFY_CORS_ORIGINS=https://notify.goreecloud.com
GOREECLOUD_NOTIFY_SESSION_COOKIE_SECURE=true
GOREECLOUD_NOTIFY_SESSION_LIFETIME_MINUTES=720
GOREECLOUD_NOTIFY_SESSION_IDLE_MINUTES=60
GOREECLOUD_NOTIFY_SESSION_TOUCH_MINUTES=5

# REQUIRED before startup. Add the narrow Docker CIDR used by the approved Caddy
# proxy network to the protected runtime environment file, for example:
# GOREECLOUD_NOTIFY_TRUSTED_PROXY_CIDRS=<approved-proxy-network-cidr>
# Production startup fails closed when this setting is absent.

GOREECLOUD_NOTIFY_LOGIN_RATE_WINDOW_MINUTES=5
GOREECLOUD_NOTIFY_LOGIN_RATE_ACCOUNT_ATTEMPTS=5
GOREECLOUD_NOTIFY_LOGIN_RATE_SOURCE_ATTEMPTS=20
GOREECLOUD_NOTIFY_LOGIN_RATE_COOLDOWN_MINUTES=5
GOREECLOUD_NOTIFY_LOGIN_RATE_STATE_TTL_HOURS=24
GOREECLOUD_NOTIFY_LOGIN_SECURITY_EVENT_RETENTION_DAYS=30

# Bootstrap only. Do not put a real value in source control. If initial production
# administrator provisioning is still required, add GOREECLOUD_NOTIFY_ADMIN_TOKEN
# only to the protected target-host environment file, provision the administrator,
# then remove the token from the runtime configuration. Routine administration uses
# authenticated administrator sessions.
