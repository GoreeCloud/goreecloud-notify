# Non-secret development defaults only.
GOREECLOUD_NOTIFY_ENVIRONMENT=development
GOREECLOUD_NOTIFY_DATABASE_URL=sqlite:////data/goreecloud_notify.db
GOREECLOUD_NOTIFY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Bootstrap only: generate a high-entropy value locally; never commit the real token.
# After the first administrator is provisioned, routine administration uses human admin sessions.
GOREECLOUD_NOTIFY_ADMIN_TOKEN=change-me-in-local-env
VITE_API_BASE_URL=http://127.0.0.1:8000

# Development-only web-session defaults. Production HTTPS must set COOKIE_SECURE=true.
GOREECLOUD_NOTIFY_SESSION_COOKIE_SECURE=false
GOREECLOUD_NOTIFY_SESSION_LIFETIME_MINUTES=720
GOREECLOUD_NOTIFY_SESSION_IDLE_MINUTES=60
GOREECLOUD_NOTIFY_SESSION_TOUCH_MINUTES=5

# Login abuse controls. Forwarded client addresses are ignored unless the direct peer is in an approved trusted proxy CIDR.
GOREECLOUD_NOTIFY_TRUSTED_PROXY_CIDRS=
GOREECLOUD_NOTIFY_LOGIN_RATE_WINDOW_MINUTES=5
GOREECLOUD_NOTIFY_LOGIN_RATE_ACCOUNT_ATTEMPTS=5
GOREECLOUD_NOTIFY_LOGIN_RATE_SOURCE_ATTEMPTS=20
GOREECLOUD_NOTIFY_LOGIN_RATE_COOLDOWN_MINUTES=5
GOREECLOUD_NOTIFY_LOGIN_RATE_STATE_TTL_HOURS=24
GOREECLOUD_NOTIFY_LOGIN_SECURITY_EVENT_RETENTION_DAYS=30
